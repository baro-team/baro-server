# Logs & Crash Dumps
# ============================================================
*.log
*.log.*
logs/
**/logs/
hs_err_pid*
replay_pid*

# ============================================================
# Sensitive / Environment Config (NEVER commit these)
# ============================================================
.env
.env.*
!.env.example
!.env.template

# Local application profiles (may contain DB passwords, JWT secrets, API keys)
**/application-local.yml
**/application-local.yaml
**/application-secret.yml
**/application-secret.yaml
**/application-prod.yml
**/application-prod.yaml

# AWS IoT / TLS certificates & private keys
**/certs/
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/*.truststore

